{
  "name": "orunvoca-windows",
  "productName": "옳은VOCA",
  "version": "1.0.1",
  "description": "옳은VOCA Windows 데스크톱 셸 (unsigned, 배포 전 검증용)",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "smoke:source": "electron smoke/harness-main.js --label=source",
    "package:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.3.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "kr.co.orunvoca.windows",
    "productName": "옳은VOCA",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "icon": "build/icon.ico",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "publish": null,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "OrunVoca-Setup-${version}-x64-unsigned.${ext}"
    }
  }
}
